{
  "$metadata": {
    "tokenSetOrder": ["colors/brand", "colors/surface", "colors/border", "colors/text", "colors/status", "colors/neutral", "typography", "radius", "shadow"]
  },

  "colors/brand": {
    "50":  { "$value": "#FFFBEB", "$type": "color" },
    "100": { "$value": "#FEF3C7", "$type": "color" },
    "200": { "$value": "#FDE68A", "$type": "color" },
    "300": { "$value": "#FCD34D", "$type": "color" },
    "400": { "$value": "#FBBF24", "$type": "color" },
    "500": { "$value": "#D4920F", "$type": "color" },
    "600": { "$value": "#B07B0C", "$type": "color" },
    "700": { "$value": "#8A5C09", "$type": "color" },
    "800": { "$value": "#6B4207", "$type": "color" },
    "900": { "$value": "#4A2D05", "$type": "color" }
  },

  "colors/surface": {
    "base":    { "$value": "#0D1219", "$type": "color" },
    "raised":  { "$value": "#121924", "$type": "color" },
    "overlay": { "$value": "#171F2B", "$type": "color" },
    "sidebar": { "$value": "#090D13", "$type": "color" }
  },

  "colors/border": {
    "subtle":  { "$value": "#1E222D", "$type": "color" },
    "default": { "$value": "#262C3C", "$type": "color" },
    "strong":  { "$value": "#37405A", "$type": "color" }
  },

  "colors/text": {
    "primary":     { "$value": "#EFF0F5", "$type": "color" },
    "secondary":   { "$value": "#A8AAB8", "$type": "color" },
    "tertiary":    { "$value": "#6B6E7E", "$type": "color" },
    "placeholder": { "$value": "#565868", "$type": "color" },
    "inverse":     { "$value": "#0D1219", "$type": "color" },
    "brand":       { "$value": "#D4920F", "$type": "color" }
  },

  "colors/status": {
    "success": {
      "50":  { "$value": "#0A1F14", "$type": "color" },
      "100": { "$value": "#0E2B1A", "$type": "color" },
      "500": { "$value": "#22C55E", "$type": "color" },
      "700": { "$value": "#4ADE80", "$type": "color" }
    },
    "warning": {
      "50":  { "$value": "#1A1808", "$type": "color" },
      "100": { "$value": "#25230D", "$type": "color" },
      "500": { "$value": "#EAB308", "$type": "color" },
      "700": { "$value": "#FDE047", "$type": "color" }
    },
    "danger": {
      "50":  { "$value": "#1F0A0A", "$type": "color" },
      "100": { "$value": "#2B0E0E", "$type": "color" },
      "500": { "$value": "#EF4444", "$type": "color" },
      "700": { "$value": "#F87171", "$type": "color" }
    }
  },

  "colors/neutral": {
    "50":  { "$value": "#F5F5F5", "$type": "color" },
    "100": { "$value": "#E5E5E5", "$type": "color" },
    "200": { "$value": "#D4D4D4", "$type": "color" },
    "300": { "$value": "#A3A3A3", "$type": "color" },
    "400": { "$value": "#737373", "$type": "color" },
    "500": { "$value": "#525252", "$type": "color" },
    "600": { "$value": "#404040", "$type": "color" },
    "700": { "$value": "#262626", "$type": "color" },
    "800": { "$value": "#171717", "$type": "color" },
    "900": { "$value": "#0A0A0A", "$type": "color" }
  },

  "typography": {
    "fontSans": { "$value": "Inter", "$type": "fontFamilies" },
    "fontMono": { "$value": "DM Mono", "$type": "fontFamilies" },
    "scale": {
      "xs":   { "$value": "10", "$type": "fontSizes" },
      "sm":   { "$value": "12", "$type": "fontSizes" },
      "base": { "$value": "14", "$type": "fontSizes" },
      "lg":   { "$value": "16", "$type": "fontSizes" },
      "xl":   { "$value": "20", "$type": "fontSizes" },
      "2xl":  { "$value": "24", "$type": "fontSizes" }
    }
  },

  "radius": {
    "xs":   { "$value": "2",    "$type": "borderRadius" },
    "sm":   { "$value": "4",    "$type": "borderRadius" },
    "md":   { "$value": "6",    "$type": "borderRadius" },
    "lg":   { "$value": "8",    "$type": "borderRadius" },
    "xl":   { "$value": "12",   "$type": "borderRadius" },
    "2xl":  { "$value": "16",   "$type": "borderRadius" },
    "full": { "$value": "9999", "$type": "borderRadius" }
  },

  "shadow": {
    "xs": { "$value": "0 1px 2px rgba(0,0,0,0.25)",                                        "$type": "boxShadow" },
    "sm": { "$value": "0 1px 3px rgba(0,0,0,0.35), 0 1px 2px rgba(0,0,0,0.25)",            "$type": "boxShadow" },
    "md": { "$value": "0 4px 8px rgba(0,0,0,0.40), 0 2px 4px rgba(0,0,0,0.30)",            "$type": "boxShadow" },
    "lg": { "$value": "0 10px 20px rgba(0,0,0,0.45), 0 4px 8px rgba(0,0,0,0.30)",          "$type": "boxShadow" },
    "xl": { "$value": "0 20px 40px rgba(0,0,0,0.50), 0 8px 16px rgba(0,0,0,0.35)",         "$type": "boxShadow" }
  }
}
